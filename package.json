{
  "name": "jpm-enterprise-compliance-system",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend & npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "db:generate": "npm run prisma:generate --workspace backend",
    "db:push": "npm run prisma:push --workspace backend",
    "db:seed": "npm run prisma:seed --workspace backend"
  }
}
